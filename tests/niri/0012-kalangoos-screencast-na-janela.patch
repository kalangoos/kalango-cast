+    /// KalangoOS: the GBM device of the render node behind the window's EGL display (None without one: llvmpipe).
+    #[cfg(feature = "xdp-gnome-screencast")]
+    fn open_gbm_device(
+        &mut self,
+    ) -> Option<smithay::backend::allocator::gbm::GbmDevice<smithay::backend::drm::DrmDeviceFd>> {
+        use smithay::backend::allocator::gbm::GbmDevice;
+        use smithay::backend::drm::DrmDeviceFd;
+        use smithay::utils::DeviceFd;
+
+        let renderer = self.backend.renderer();
+        let display = renderer.egl_context().display();
+        let node = EGLDevice::device_for_display(display)
+            .ok()?
+            .try_get_render_node()
+            .ok()??;
+        let path = node.dev_path()?;
+        let file = std::fs::OpenOptions::new()
+            .read(true)
+            .write(true)
+            .open(&path)
+            .map_err(|err| warn!("screencast: error opening {path:?}: {err}"))
+            .ok()?;
+        let fd = DrmDeviceFd::new(DeviceFd::from(std::os::fd::OwnedFd::from(file)));
+        match GbmDevice::new(fd) {
+            Ok(gbm) => {
+                info!("screencast: GBM device on {path:?}");
+                Some(gbm)
+            }
+            Err(err) => {
+                warn!("screencast: error creating GBM device: {err}");
+                None
+            }
+        }
+    }
+
+    #[cfg(feature = "xdp-gnome-screencast")]
+    pub fn gbm_device(
+        &self,
+    ) -> Option<smithay::backend::allocator::gbm::GbmDevice<smithay::backend::drm::DrmDeviceFd>> {
+        self.gbm.clone()
+    }
+
     pub fn seat_name(&self) -> String {
         "winit".to_owned()
     }
